[Unit]
Description=AI Orchestrator — Agentic Team UI
After=network.target

[Service]
Type=simple
User=appuser
WorkingDirectory=/opt/ai-orchestrator
Environment=NODE_ENV=production
Environment=PORT=5002
ExecStart=/usr/bin/node apps/agentic-team-ui/dist/server.js
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/ai-orchestrator/agentic-team-ui.log
StandardError=append:/var/log/ai-orchestrator/agentic-team-ui.log

[Install]
WantedBy=multi-user.target
