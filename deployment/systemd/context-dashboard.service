[Unit]
Description=AI Orchestrator — Context Dashboard
After=network.target

[Service]
Type=simple
User=appuser
WorkingDirectory=/opt/ai-orchestrator
Environment=NODE_ENV=production
Environment=PORT=5003
ExecStart=/usr/bin/node packages/context-dashboard/dist/index.js
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/ai-orchestrator/context-dashboard.log
StandardError=append:/var/log/ai-orchestrator/context-dashboard.log

[Install]
WantedBy=multi-user.target
