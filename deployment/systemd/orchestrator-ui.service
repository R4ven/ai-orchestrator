[Unit]
Description=AI Orchestrator UI
After=network.target

[Service]
Type=simple
User=appuser
WorkingDirectory=/opt/ai-orchestrator
Environment=NODE_ENV=production
Environment=PORT=5001
ExecStart=/usr/bin/node apps/orchestrator-ui/dist/server.js
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/ai-orchestrator/orchestrator-ui.log
StandardError=append:/var/log/ai-orchestrator/orchestrator-ui.log

[Install]
WantedBy=multi-user.target
