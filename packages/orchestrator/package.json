{
  "name": "@ai-orchestrator/orchestrator",
  "version": "0.1.0",
  "description": "Step-based workflow orchestrator that coordinates cloud and local AI coding assistants (Claude, Codex, Gemini, Copilot, Ollama, llama.cpp).",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ai-orchestrator": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "tsx src/cli/index.ts",
    "dev": "tsx watch src/cli/index.ts",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ai-orchestrator/context-graph": "*",
    "@ai-orchestrator/shared": "*",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
