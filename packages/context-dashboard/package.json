  },
  "dependencies": {
    "@ai-orchestrator/context-graph": "*",
    "@ai-orchestrator/shared": "*",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
