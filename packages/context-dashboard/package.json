{
  "name": "@ai-orchestrator/context-dashboard",
  "version": "0.1.0",
  "description": "Unified dashboard aggregating the Orchestrator's and Agentic Team's independent context-graph databases for visualization and search.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "context-dashboard": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
